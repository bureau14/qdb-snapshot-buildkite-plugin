#!/usr/bin/env bash
# The command of a snapshot gate job: python -m snapdep <step>.
#
# The functions are in lib/hook.bash. The agent sources this file through
# its hook wrapper, so it must run main unconditionally.
set -euo pipefail

# shellcheck source=../lib/hook.bash
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/hook.bash"
main
